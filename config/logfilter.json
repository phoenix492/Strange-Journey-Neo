{
  "configVersion": 1,
  "enabled": true,
  "rules": [
    {
      "name": "Suppress OPENGL spam",
      "enabled": true,
      "type": "MESSAGE_REGEX",
      "pattern": "GL_INVALID_OPERATION in glBlitFramebuffer",
      "action": "DENY"
    },
    {
      "name": "Suppress Mob Failed Spam",
      "enabled": true,
      "type": "MESSAGE_REGEX",
      "pattern": "Failed to create mob",
      "action": "DENY"
    },
    {
      "name": "Suppress malum invalid config correction message",
      "enabled": true,
      "type": "MESSAGE_REGEX",
      "pattern": "malum-client.toml is not correct. Correcting",
      "action": "DENY"
    }
  ]
}